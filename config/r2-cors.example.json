{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://drive.example.com",
          "http://localhost:3000"
        ],
        "methods": [
          "PUT"
        ],
        "headers": [
          "Content-Type"
        ]
      },
      "exposeHeaders": [
        "ETag"
      ],
      "maxAgeSeconds": 3600
    }
  ]
}
